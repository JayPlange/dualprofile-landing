# Environment Variables Example
# Copy this to .env.local and fill in your actual values

# Lemon Squeezy Configuration
LEMON_WEBHOOK_SECRET=your_webhook_secret_here
LEMON_API_KEY=your_api_key_here
LEMON_STORE_ID=your_store_id_here

# ConvertKit Configuration (for newsletter)
CONVERTKIT_API_KEY=your_convertkit_public_api_key
CONVERTKIT_FORM_ID=9012801

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Convex Configuration
CONVEX_DEPLOYMENT=your_convex_deployment_url
CONVEX_ADMIN_KEY=your_admin_key_here

# Extension Configuration
EXTENSION_ID=your_extension_id_here
EXTENSION_VERSION=1.0.0

# Security
JWT_SECRET=your_jwt_secret_for_tokens
CORS_ORIGIN=https://yourdomain.com

# Development
NODE_ENV=development
